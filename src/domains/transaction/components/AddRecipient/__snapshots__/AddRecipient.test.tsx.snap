                                            stroke-width="2"
                                          >
                                            <circle
                                              cx="10"
                                              cy="5"
                                              r="4"
                                            />
                                            <path
                                              d="M2 19c0-4.899 3.544-9 8-9 4.354 0 8 3.987 8 9"
                                            />
                                          </g>
                                        </svg>
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            </div>
                          </div>
                        </span>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </fieldset>
        </div>
        <fieldset
          class="[&:focus-within_.FormLabel]:text-theme-danger-500 [&>.FormLabel]:text-theme-danger-500 flex min-w-0 flex-col"
        >
          <label
            class="FormLabel hover:text-theme-primary-600! mb-2 flex font-semibold leading-[17px] text-theme-secondary-text transition-colors duration-100 text-sm"
            data-testid="FormLabel"
            for="amount"
          >
            <span
              class="items-centers flex w-full justify-between"
            >
              <div
                class="flex flex-row items-center gap-1.5"
              >
                <span>
                  Amount
                </span>
                <span
                  class="text-sm text-theme-secondary-700 dim:text-theme-dim-200 dark:text-theme-dark-200 sm:hidden"
                >
                  (
                  <span>
                    <span>
                      <span
                        class="whitespace-nowrap"
                        data-testid="Amount"
                      >
                        0.00
                      </span>
                    </span>
                  </span>
                  )
                </span>
              </div>
              <div
                class="flex flex-row items-center gap-2"
              >
                <div
                  class="hidden text-theme-secondary-700 dim:text-theme-dim-200 dark:text-theme-dark-200 sm:flex"
                  data-testid="AddRecipient__available"
                >
                  <span
                    class="hidden pr-1 sm:inline"
                  >
                    Balance
                    :
                  </span>
                  <span>
                    <span>
                      <span
                        class="whitespace-nowrap"
                        data-testid="Amount"
                      >
                        0.00 ARK
                      </span>
                    </span>
                  </span>
                </div>
                <span
                  class="inline-flex"
                >
                  <button
                    class="space-x-3 relative items-center inline-flex justify-center font-semibold text-center transition-all duration-100 ease-linear outline-hidden rounded cursor-pointer focus:outline-hidden focus:ring-2 focus:ring-theme-primary-400 disabled:cursor-not-allowed border-none p-0 text-sm text-theme-navy-600 underline-offset-4 hover:text-theme-navy-700 hover:underline dim:text-theme-dim-navy-600 dim:hover:text-theme-dim-navy-700 dark:hover:text-theme-dark-navy-500"
                    data-testid="AddRecipient__send-all"
                    type="button"
                  >
                    <div
                      class="flex items-center gap-2"
                    >
                      Send All
                    </div>
                  </button>
                </span>
              </div>
            </span>
          </label>
          <div
            class="relative flex"
          >
            <div
              class="flex-1"
            >
              <div
                class="relative"
              >
                <div
                  class="flex w-full appearance-none items-center space-x-2 rounded px-4 text-theme-text transition-colors duration-200 border border-theme-danger-500 bg-theme-background focus-within:ring-theme-danger-500 focus-within:ring-1 h-12 overflow-hidden sm:h-14"
                >
                  <div
                    class="relative flex h-full flex-1"
                  >
                    <input
                      aria-invalid="true"
                      autocomplete="off"
                      class="bg-transparent! p-0! focus:ring-transparent! focus:outline-hidden focus:shadow-none [&.shadow-none]:shadow-none no-ligatures text-sm! sm:text-base! w-full border-none placeholder:text-theme-secondary-400 dim:placeholder:text-theme-dim-500 dark:placeholder:text-theme-secondary-700"
                      data-testid="AddRecipient__amount"
                      name="amount"
                      placeholder="Enter an amount"
                      type="text"
                      value="0"
                    />
                  </div>
                  <div
                    class="flex items-center divide-x divide-theme-secondary-300 dim:divide-theme-dim-700 dark:divide-theme-secondary-800 text-theme-danger-500"
                    data-testid="Input__addon-end"
                  >
                    <div
                      class=""
                    >
                      <span>
                        <span>
                          <span
                            data-errortext="The amount is below the minimum (0.00000001 Mainsail)"
                            data-testid="Input__error"
                          >
                            <div
                              class="text-theme-danger-500"
                            >
                              <div
                                style="height: 20px; width: 20px;"
                              >
                                <svg
                                  id="circle-exclamation-mark"
                                  style="height: 100%; width: 100%;"
                                  viewBox="0 0 20 20"
                                  x="0"
                                  xml:space="preserve"
                                  xmlns="http://www.w3.org/2000/svg"
                                  y="0"
                                >
                                  <g
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                  >
                                    <circle
                                      cx="10"
                                      cy="10"
                                      r="9"
                                      stroke-miterlimit="10"
                                    />
                                    <path
                                      d="M10 10.5v-5"
                                      stroke-linecap="round"
                                      stroke-miterlimit="10"
                                    />
                                    <path
                                      d="M10 14h0"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                    />
                                  </g>
                                </svg>
                              </div>
                            </div>
                          </span>
                        </span>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </fieldset>
      </div>
    </div>
  </div>
</div>
`;
